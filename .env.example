# Not needed for `npm run dev` — Vite doesn't run the /api function.
# For local shared storage via `vercel dev`, connect a Redis (Upstash)
# database to the project in the Vercel dashboard (Storage > Create
# Database), then run `vercel env pull` to fetch these automatically:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
